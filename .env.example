# Local development works without accounts. Never commit .env.local.
APP_ENV=development
PORT=3001
DATA_DIR=./data
# Required for a hosted deployment. Service-role key stays on the server.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
APP_SECRET=
# Set to the connected HTTPS deployment URL. Use https://sendfiggle.com only after DNS/domain setup.
# On Vercel, an unset value falls back to VERCEL_PROJECT_PRODUCTION_URL or VERCEL_URL.
PUBLIC_BASE_URL=
CRON_SECRET=
# Hosted analytics; disabled unless APP_ENV=production and host is public.
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com
# Only approved campaign labels are forwarded; unknown values become "other".
ANALYTICS_CAMPAIGNS=launch,instagram,tiktok,newsletter,friends

# Optional local file-backed development only. Never bypasses production/cloud quotas.
LOCAL_TEST_MODE=0

# Optional video beta: OFF by default. Provider generation costs money; users see no paywall.
VIDEO_ENABLED=0
FAL_KEY=
# fal account user ID expected in signed webhook headers (not the API key).
FAL_WEBHOOK_USER_ID=
# These independent limits are enforced even when LOCAL_TEST_MODE=1.
VIDEO_VISITOR_DAILY_LIMIT=1
VIDEO_IP_DAILY_LIMIT=2
VIDEO_GLOBAL_DAILY_LIMIT=3
VIDEO_INFLIGHT_LIMIT=2
VIDEO_DAILY_BUDGET_CENTS=200
VIDEO_TOTAL_BUDGET_CENTS=1000
# Requires the Supabase settings and an explicitly connected HTTPS PUBLIC_BASE_URL above.
